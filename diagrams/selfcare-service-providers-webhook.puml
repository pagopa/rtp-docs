@startuml
!theme materia

title SelfCare Webhook Service Providers Flow

participant "SELFCARE" as SC
participant "RTP-REGISTRY" as REG
database "service_providers collection" as DB
database "notification collection" as NDB

autonumber

SC -> REG: POST /selfcare/webhook\n(Body: SC-Delegations notification)
note right of REG
  Authentication (API-Key & JWT)
  is validated upstream by APIM policy
end note
activate REG

alt Valid credentials (API-Key & JWT)
    REG -> NDB: find notification by notificationId
    activate NDB

    alt notificationId already present
        NDB --> REG: Notification Document
        deactivate NDB
        REG --> SC: 200 OK
        note right of REG
          Idempotency: notification
          already processed, no action
        end note

    else notificationId not found
        NDB --> REG: empty
        deactivate NDB

        REG -> DB: find TSP by id
        activate DB

        alt TSP found
            DB --> REG: TSP Document
            deactivate DB

            alt status == "ACTIVE" and eventType == "ADD"
                REG -> DB: add service_provider to service_providers collection
                activate DB
                DB --> REG: updated
                deactivate DB
                REG -> NDB: save notificationId
                activate NDB
                NDB --> REG: saved
                deactivate NDB
                REG --> SC: 200 OK

            else status == "DELETED" and eventType == "UPDATE"
                alt SP found in service_providers
                    REG -> DB: remove service_provider from service_providers collection
                    activate DB
                    DB --> REG: updated
                    deactivate DB
                    REG -> NDB: save notificationId
                    activate NDB
                    NDB --> REG: saved
                    deactivate NDB
                    REG --> SC: 200 OK
                else SP not found
                    REG --> SC: 404 Not Found
                    note right of REG
                      SP not present in TSP
                    end note
                end

            else unexpected status or eventType
                REG --> SC: 400 Bad Request
                note right of REG
                  Unexpected status
                  or eventType
                end note
            end

        else TSP not found
            DB --> REG: empty
            deactivate DB
            REG --> SC: 404 Not Found
            note right of REG
              TSP must be configured
              manually first
            end note
        end
    end

else Invalid or missing API-Key / JWT
    REG --> SC: 401 Unauthorized
    deactivate REG
end

@enduml
